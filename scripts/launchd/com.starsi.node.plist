<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>com.starsi.node</string>
    <key>ProgramArguments</key>
    <array>
        <string>__REPO__/.venv/bin/starsi-__ROLE__</string>
        <string>--config</string>
        <string>__REPO__/apps/__ROLE__/configs/__ROLE__.yaml</string>
    </array>
    <key>WorkingDirectory</key><string>__REPO__/apps/__ROLE__</string>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><true/>
    <key>StandardOutPath</key><string>/var/log/starsi.log</string>
    <key>StandardErrorPath</key><string>/var/log/starsi.err</string>
</dict>
</plist>
